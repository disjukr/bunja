{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "declaration": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "noEmit": true
  },
  "include": [
    "*.ts"
  ],
  "exclude": [
    "dist"
  ]
}
