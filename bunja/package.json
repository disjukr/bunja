{
  "name": "bunja",
  "type": "module",
  "version": "2.0.0",
  "description": "State Lifetime Manager",
  "main": "./dist/bunja.js",
  "types": "dist/bunja.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bunja.d.ts",
      "default": "./dist/bunja.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "default": "./dist/solid.js"
    }
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --conditions=browser --test test.ts solid_test.ts react_test.ts override_test.ts"
  },
  "keywords": [
    "bunja",
    "di"
  ],
  "author": "JongChan Choi <jong@chan.moe>",
  "license": "Zlib",
  "repository": {
    "type": "git",
    "url": "https://github.com/disjukr/bunja.git",
    "directory": "bunja"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-test-renderer": "^19.3.0",
    "react": "^19",
    "react-test-renderer": "^19.3.1",
    "solid-js": "^1.9.7",
    "tsdown": "0.23.3",
    "typescript": "^5.6.3",
    "tsx": "^4.20.0"
  },
  "peerDependencies": {
    "@types/react": "*",
    "react": ">=18",
    "solid-js": "^1"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  }
}
