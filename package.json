{
  "name": "bunja-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter bunja build && pnpm -r typecheck",
    "test": "pnpm --filter bunja test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "version:release": "node scripts/version.mjs"
  },
  "devDependencies": {
    "@types/node": "^26",
    "jsr": "0.14.3"
  }
}
